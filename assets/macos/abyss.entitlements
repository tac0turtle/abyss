<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Sandbox, as defence in depth for a client that parses untrusted
	     network input. Nothing else is granted: no file access, no network
	     server, no devices, no Apple Events. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Outgoing connections, for MTProto over TCP. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
